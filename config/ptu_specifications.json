{
  "model": "FLIR PTU D100E",
  "serial": {
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "none",
    "stopbits": 1,
    "timeout_s": 1.0
  },
  "defaults": {
    "pan_speed": 1000,
    "tilt_speed": 1000,
    "pan_acceleration": 5000,
    "tilt_acceleration": 5000,
    "hold_power_mode": "LOW",
    "move_power_mode": "LOW",
    "sequential_axes": false
  },
  "position_tolerance_steps": 5,
  "settle_time_s": 2.0,
  "await_timeout_s": 30.0,
  "command_timeout_s": 3.0,
  "poll_interval_s": 0.2,
  "mount_geometry": {
    "description": "How the camera is physically mounted on the PTU. sensor_inverted: the camera mounts with its labels upright but the sensor is then upside-down, so the raw image is rotated 180 deg relative to the scene; downstream code (mosaic, derived products, backplane roll, aim_ptu preview) reads this and corrects. Set false after remounting the camera the other way up. camera_offset_m: entrance-pupil offset from the pan/tilt axes intersection, tilt-stage frame (forward/along-tilt-axis/up), meters, for backplane parallax. boresight offsets are calibratable from a mosaic model fit.",
    "sensor_inverted": true,
    "camera_offset_m": {
      "forward": 0.0,
      "along_tilt_axis": 0.0,
      "up": 0.0
    },
    "boresight_pan_offset_deg": 0.0,
    "boresight_tilt_offset_deg": 0.0
  },
  "discovery": {
    "probe_command": "VM",
    "model_filter": "D100",
    "serial_number_command": "VS",
    "firmware_command": "V",
    "probe_timeout_s": 1.0
  },
  "gpm": {
    "detection_command": "GS",
    "geo_point_settle_time_s": 3.0,
    "commands": {
      "gps_position": "GLLA",
      "latitude": "GL",
      "longitude": "GO",
      "altitude": "GA",
      "attitude": "GRPY",
      "roll": "GR",
      "pitch": "GP",
      "yaw": "GY",
      "geo_point": "GG",
      "geo_distance": "GGD",
      "landmark_add": "GMA",
      "landmark_get": "GM",
      "landmark_count": "GMN",
      "landmark_delete": "GMD",
      "landmark_clear": "GMC",
      "calibrate": "GC",
      "calibration_quality": "GCQ",
      "camera_offset": "GCP",
      "save_settings": "GDS",
      "restore_settings": "GDR",
      "factory_reset": "GDF",
      "status": "GS",
      "point_type": "GPT"
    }
  }
}
